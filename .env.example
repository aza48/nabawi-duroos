# Copy to .env.local for local development with a real backend.
# Every value here is a placeholder — use your OWN services, never production ones.
# The app also runs without any of these (demo mode / static data).

# Neon Postgres connection string (Vercel Storage sets the DATABASE_* family
# automatically when you connect a database to the project)
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Brevo (transactional email: confirmations, lesson alerts, MESH codes)
BREVO_API_KEY="xkeysib-your-own-key"
BREVO_SENDER_EMAIL="you@example.com"
BREVO_SENDER_NAME="Medina Hub"

# Duroos admin console password (gates /admin and /api/admin/*)
ADMIN_PASSWORD="choose-a-strong-password"

# Shared secret for the reminders cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET="choose-a-long-random-string"

# Comma-separated emails auto-promoted to MESH admin on first sign-in
MESH_ADMIN_EMAILS="you@example.com"

# Canonical site URL used in email links (optional; defaults to request origin)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
