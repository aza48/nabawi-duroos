{
  "name": "mesh",
  "version": "2.0.0",
  "private": true,
  "description": "MESH — Medina English Student Hub",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/server/seed/run.ts",
    "admin:invite": "tsx --tsconfig tsconfig.json scripts/admin-invite.ts",
    "admin:reset": "tsx --tsconfig tsconfig.json scripts/admin-reset.ts",
    "watch:once": "tsx --tsconfig tsconfig.json scripts/watch-once.ts",
    "go-live": "tsx --tsconfig tsconfig.json scripts/go-live.ts",
    "content:sync": "tsx --tsconfig tsconfig.json scripts/content-sync.ts",
    "shaykh:sync": "tsx --tsconfig tsconfig.json scripts/shaykh-sync.ts",
    "questions:add": "tsx --tsconfig tsconfig.json scripts/questions.ts add",
    "questions:pull": "tsx --tsconfig tsconfig.json scripts/questions.ts pull"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.18",
    "@electric-sql/pglite": "^0.5.15",
    "@neondatabase/serverless": "^1.2.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "adhan": "^4.4.6",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "minisearch": "^7.2.0",
    "next": "^16.4.5",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "otpauth": "^9.6.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
